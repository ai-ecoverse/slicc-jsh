{
  "name": "@ai-ecoverse/slicc-jsh",
  "version": "0.0.0",
  "description": "Node.js-compatible runtime for slicc-kernel: the node and jsh commands (abi: js)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-jsh.git"
  },
  "homepage": "https://github.com/ai-ecoverse/slicc-jsh",
  "bugs": {
    "url": "https://github.com/ai-ecoverse/slicc-jsh/issues"
  },
  "bin": {
    "jsh": "dist/host/jsh.mjs"
  },
  "engines": {
    "node": ">=22",
    "slicc-kernel": ">=1.53.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-jsh",
    "publish": true
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist"
  ],
  "slicc": {
    "commands": {
      "node": {
        "abi": "js",
        "module": "dist/node.mjs"
      },
      "jsh": {
        "abi": "js",
        "module": "dist/jsh.mjs"
      }
    },
    "binfmt": {
      ".jsh": "jsh"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-host.mjs",
    "prepack": "npm run build && node scripts/strip-own-scripts.mjs",
    "prepare": "npm run build",
    "lint": "node scripts/lint.mjs",
    "test": "npm run test:golden && npm run test:jsh && npm run test:integration",
    "test:golden": "node --max-old-space-size=512 scripts/golden.mjs check",
    "test:integration": "node --max-old-space-size=512 --test --test-concurrency=3 --test-timeout=120000 test/integration/*.test.mjs",
    "test:cert": "node --max-old-space-size=512 test/integration/cert/run.mjs",
    "test:browser": "node --max-old-space-size=512 --test --test-concurrency=1 --test-timeout=900000 --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs test/browser/*.test.mjs",
    "browser": "slicc-cdp install-browser --version \"$npm_package_config_chrome\"",
    "test:node-parallel": "node --max-old-space-size=512 test/node-parallel/run.mjs",
    "golden:record": "node --max-old-space-size=512 scripts/golden.mjs record",
    "test:jsh": "node --max-old-space-size=512 scripts/jsh-golden.mjs check",
    "jsh:record": "node --max-old-space-size=512 scripts/jsh-golden.mjs record",
    "release": "semantic-release",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish"
  },
  "config": {
    "chrome": "156.0.8078.4"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-cdp": "1.26.2",
    "@ai-ecoverse/slicc-kernel": "1.99.0",
    "@ai-ecoverse/slicc-shared-web": "1.20.0",
    "@ai-ecoverse/wasi-pnpm": "12.9.1-8",
    "@ai-ecoverse/wasm-bash": "5.3.0-18",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-7",
    "@noble/hashes": "2.4.0",
    "abort-controller": "3.0.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "browserify-aes": "1.2.0",
    "browserify-des": "1.0.2",
    "browserify-zlib": "0.2.0",
    "cjs-module-lexer": "2.3.0",
    "esbuild": "0.28.2",
    "minimatch": "10.2.6",
    "monocart-coverage-reports": "2.13.2",
    "node-inspect-extracted": "3.3.4",
    "pako": "3.0.2",
    "process": "0.11.10",
    "readable-stream": "4.8.0",
    "semantic-release": "25.0.9",
    "string_decoder": "1.3.0",
    "ws": "8.22.0",
    "yargs": "18.2.0"
  }
}
