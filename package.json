{
  "name": "@ai-ecoverse/slicc-jsh",
  "version": "0.1.0-8",
  "description": "Node.js-compatible runtime for slicc-kernel: the node and jsh commands (abi: js)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-jsh.git"
  },
  "homepage": "https://github.com/ai-ecoverse/slicc-jsh",
  "bugs": {
    "url": "https://github.com/ai-ecoverse/slicc-jsh/issues"
  },
  "bin": {
    "jsh": "dist/host/jsh.mjs"
  },
  "engines": {
    "node": ">=22",
    "slicc-kernel": ">=1.53.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist"
  ],
  "slicc": {
    "commands": {
      "node": {
        "abi": "js",
        "module": "dist/node.mjs",
        "argv0": "node"
      },
      "jsh": {
        "abi": "js",
        "module": "dist/jsh.mjs",
        "argv0": "jsh"
      }
    },
    "binfmt": {
      ".jsh": "jsh"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-host.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "lint": "node scripts/lint.mjs",
    "test": "npm run test:golden && npm run test:jsh && npm run test:integration",
    "test:golden": "node --max-old-space-size=512 scripts/golden.mjs check",
    "test:integration": "node --max-old-space-size=512 --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:cert": "node --max-old-space-size=512 test/integration/cert/run.mjs",
    "test:node-parallel": "node --max-old-space-size=512 test/node-parallel/run.mjs",
    "golden:record": "node --max-old-space-size=512 scripts/golden.mjs record",
    "test:jsh": "node --max-old-space-size=512 scripts/jsh-golden.mjs check",
    "jsh:record": "node --max-old-space-size=512 scripts/jsh-golden.mjs record"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.54.2",
    "abort-controller": "3.0.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "node-inspect-extracted": "3.3.4",
    "process": "0.11.10",
    "readable-stream": "4.8.0",
    "string_decoder": "1.3.0"
  }
}
