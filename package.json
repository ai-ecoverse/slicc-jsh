{
  "name": "@ai-ecoverse/slicc-jsh",
  "version": "0.0.0",
  "description": "Node.js-compatible runtime for slicc-kernel: the node and jsh commands (abi: js)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-jsh.git"
  },
  "homepage": "https://github.com/ai-ecoverse/slicc-jsh",
  "bugs": {
    "url": "https://github.com/ai-ecoverse/slicc-jsh/issues"
  },
  "bin": {
    "jsh": "dist/host/jsh.mjs"
  },
  "engines": {
    "node": ">=22",
    "slicc-kernel": ">=1.149.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-jsh",
    "publish": true
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist"
  ],
  "slicc": {
    "commands": {
      "node": {
        "abi": "js",
        "module": "dist/node.mjs"
      },
      "jsh": {
        "abi": "js",
        "module": "dist/jsh.mjs"
      }
    },
    "binfmt": {
      ".jsh": "jsh"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-host.mjs",
    "prepack": "npm run build && node scripts/strip-own-scripts.mjs",
    "prepare": "npm run build && slicc-install-hooks",
    "lint": "node scripts/lint.mjs && shellcheck -s sh install.sh test/install/run.sh",
    "pretest": "npm run browser",
    "test": "node --max-old-space-size=512 --test --test-concurrency=3 --test-timeout=120000 --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "test:golden": "node --max-old-space-size=512 scripts/golden.mjs check",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "browser": "slicc-cdp install-browser --version \"$npm_package_config_chrome\"",
    "golden:record": "node --max-old-space-size=512 scripts/golden.mjs record",
    "test:jsh": "node --max-old-space-size=512 scripts/jsh-golden.mjs check",
    "jsh:record": "node --max-old-space-size=512 scripts/jsh-golden.mjs record",
    "release": "semantic-release",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish"
  },
  "config": {
    "chrome": "156.0.8078.4"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-cdp": "1.36.1",
    "@ai-ecoverse/slicc-jerk": "1.2.3",
    "@ai-ecoverse/slicc-kernel": "1.149.0",
    "@ai-ecoverse/slicc-shared-web": "2.11.2",
    "@ai-ecoverse/wasi-pnpm": "12.9.1-21",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@ai-ecoverse/wasm-tls-engine": "4.2.0-8",
    "@noble/hashes": "2.4.0",
    "@smithy/node-http-handler": "4.12.1",
    "abort-controller": "3.0.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "axios": "1.20.0",
    "browserify-aes": "1.2.0",
    "browserify-des": "1.0.2",
    "browserify-zlib": "0.2.0",
    "chai": "6.3.0",
    "chai-http": "5.1.2",
    "chokidar": "5.0.0",
    "cjs-module-lexer": "2.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "express": "5.3.0",
    "fastify": "5.12.7",
    "googleapis-common": "9.3.1",
    "got": "16.1.0",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "ioredis": "6.0.0",
    "jest": "30.5.2",
    "lefthook": "2.2.2",
    "minimatch": "10.2.6",
    "monocart-coverage-reports": "2.13.2",
    "nats": "2.29.3",
    "node-inspect-extracted": "3.3.4",
    "nodemailer": "10.1.2",
    "nodemon": "3.1.14",
    "pako": "3.0.2",
    "pg": "8.23.1",
    "piscina": "5.3.2",
    "playwright-core": "1.64.1",
    "process": "0.11.10",
    "prom-client": "15.1.3",
    "readable-stream": "4.8.0",
    "semantic-release": "25.0.9",
    "smtp-server": "3.19.23",
    "ssh2": "1.17.0",
    "string_decoder": "1.3.0",
    "superagent": "10.4.1",
    "supertest": "7.3.1",
    "tinypool": "2.2.0",
    "undici": "8.12.3",
    "ws": "8.22.0",
    "yargs": "18.2.0"
  }
}
