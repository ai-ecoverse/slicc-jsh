const D=(v)=>{if(v===undefined)return'undefined';if(typeof v==='function')return'[function]';if(typeof v==='bigint')return`${v}n`;if(v&&typeof v.then==='function'){v.then(()=>{},()=>{});return'[Promise]'}if(typeof Buffer!=='undefined'&&Buffer.isBuffer&&Buffer.isBuffer(v))return`[Buffer ${v.length}]`;if(v instanceof Uint8Array)return`[Uint8Array ${v.length}]`;try{return JSON.stringify(v)}catch{return String(v)}},E=(e)=>`THROW ${e&&e.name}${e&&e.code?` ${e.code}`:''}: ${String(e&&e.message).split('\n')[0]}`,show=(k,f)=>{let s;try{s=D(f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)},showA=async(k,f)=>{let s;try{s=D(await f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)};
show('platform', () => typeof process.platform);
show('arch', () => typeof process.arch);
show('version', () => /^v\d+\.\d+\.\d+$/.test(process.version));
show('versions.node', () => typeof process.versions.node);
show('versions.jsh', () => typeof process.versions.jsh);
show('versions.v8', () => typeof process.versions.v8);
show('release.name', () => process.release && process.release.name);
show('pid', () => typeof process.pid);
show('ppid', () => typeof process.ppid);
show('execPath', () => typeof process.execPath);
show('title', () => typeof process.title);
show('hrtime', () => Array.isArray(process.hrtime()));
show('hrtime.bigint', () => typeof process.hrtime.bigint());
show('nextTick', () => typeof process.nextTick);
show('memoryUsage', () => typeof process.memoryUsage().rss);
show('uptime', () => typeof process.uptime());
show('umask', () => typeof process.umask());
show('cpuUsage', () => typeof process.cpuUsage);
show('on', () => typeof process.on);
show('emit', () => typeof process.emit);
show('kill', () => typeof process.kill);
show('emitWarning', () => typeof process.emitWarning);
show('getuid', () => typeof process.getuid);
show('config', () => typeof process.config);
show('features', () => typeof process.features);
show('stdin.fd', () => process.stdin.fd);
show('toString', () => Object.prototype.toString.call(process));
