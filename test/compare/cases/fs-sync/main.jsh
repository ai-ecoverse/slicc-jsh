const D=(v)=>{if(v===undefined)return'undefined';if(typeof v==='function')return'[function]';if(typeof v==='bigint')return`${v}n`;if(v&&typeof v.then==='function'){v.then(()=>{},()=>{});return'[Promise]'}if(typeof Buffer!=='undefined'&&Buffer.isBuffer&&Buffer.isBuffer(v))return`[Buffer ${v.length}]`;if(v instanceof Uint8Array)return`[Uint8Array ${v.length}]`;try{return JSON.stringify(v)}catch{return String(v)}},E=(e)=>`THROW ${e&&e.name}${e&&e.code?` ${e.code}`:''}: ${String(e&&e.message).split('\n')[0]}`,show=(k,f)=>{let s;try{s=D(f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)},showA=async(k,f)=>{let s;try{s=D(await f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)};
const fs = require('fs');
show('writeFileSync', () => fs.writeFileSync('s.txt', 'one\n'));
show('appendFileSync', () => fs.appendFileSync('s.txt', 'two\n'));
show('readFileSync utf8', () => fs.readFileSync('s.txt', 'utf8'));
show('readFileSync buffer', () => Buffer.isBuffer(fs.readFileSync('s.txt')));
show('mkdirSync recursive', () => fs.mkdirSync('x/y/z', { recursive: true }));
show('mkdirSync existing', () => fs.mkdirSync('x'));
show('readdirSync sorted?', () => fs.readdirSync('dir'));
show('readdirSync withFileTypes', () => fs.readdirSync('dir', { withFileTypes: true }).map((d) => `${d.name}:${d.isDirectory() ? 'd' : 'f'}`));
show('readdirSync recursive', () => fs.readdirSync('dir', { recursive: true }).sort());
show('renameSync', () => { fs.renameSync('s.txt', 'r.txt'); return fs.existsSync('s.txt'); });
show('copyFileSync', () => { fs.copyFileSync('r.txt', 'c.txt'); return fs.readFileSync('c.txt', 'utf8'); });
show('unlinkSync', () => { fs.unlinkSync('c.txt'); return fs.existsSync('c.txt'); });
show('rmSync recursive', () => { fs.rmSync('x', { recursive: true, force: true }); return fs.existsSync('x'); });
show('realpathSync', () => fs.realpathSync('dir/../data.txt'));
show('mkdtempSync', () => typeof fs.mkdtempSync('t-'));
