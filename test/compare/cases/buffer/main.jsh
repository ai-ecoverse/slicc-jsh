const D=(v)=>{if(v===undefined)return'undefined';if(typeof v==='function')return'[function]';if(typeof v==='bigint')return`${v}n`;if(v&&typeof v.then==='function'){v.then(()=>{},()=>{});return'[Promise]'}if(typeof Buffer!=='undefined'&&Buffer.isBuffer&&Buffer.isBuffer(v))return`[Buffer ${v.length}]`;if(v instanceof Uint8Array)return`[Uint8Array ${v.length}]`;try{return JSON.stringify(v)}catch{return String(v)}},E=(e)=>`THROW ${e&&e.name}${e&&e.code?` ${e.code}`:''}: ${String(e&&e.message).split('\n')[0]}`,show=(k,f)=>{let s;try{s=D(f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)},showA=async(k,f)=>{let s;try{s=D(await f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)};
show('base64', () => Buffer.from('hello').toString('base64'));
show('base64url', () => Buffer.from([251, 255]).toString('base64url'));
show('hex', () => Buffer.from('ff00', 'hex'));
show('latin1', () => Buffer.from('é', 'latin1').length);
show('utf8 length', () => Buffer.byteLength('é✓'));
show('concat', () => Buffer.concat([Buffer.from('a'), Buffer.from('b')]).toString());
show('readUInt32BE', () => Buffer.from([0, 0, 1, 0]).readUInt32BE(0));
show('writeInt16LE', () => { const b = Buffer.alloc(2); b.writeInt16LE(-2); return [...b]; });
show('instanceof Uint8Array', () => Buffer.from('x') instanceof Uint8Array);
show('subarray shares memory', () => { const b = Buffer.from('abc'); b.subarray(0, 1)[0] = 122; return b.toString(); });
show('require(buffer).Buffer === Buffer', () => require('buffer').Buffer === Buffer);
show('constants.MAX_LENGTH', () => typeof require('buffer').constants.MAX_LENGTH);
show('Blob from buffer', () => typeof require('buffer').Blob);
show('toJSON', () => Buffer.from('ab').toJSON());
show('equals', () => Buffer.from('a').equals(Buffer.from('a')));
show('inspect', () => require('util').inspect(Buffer.from('hi')));
show('atob/btoa', () => [btoa('hi'), atob('aGk=')]);
