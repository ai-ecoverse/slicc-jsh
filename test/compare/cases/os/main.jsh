const D=(v)=>{if(v===undefined)return'undefined';if(typeof v==='function')return'[function]';if(typeof v==='bigint')return`${v}n`;if(v&&typeof v.then==='function'){v.then(()=>{},()=>{});return'[Promise]'}if(typeof Buffer!=='undefined'&&Buffer.isBuffer&&Buffer.isBuffer(v))return`[Buffer ${v.length}]`;if(v instanceof Uint8Array)return`[Uint8Array ${v.length}]`;try{return JSON.stringify(v)}catch{return String(v)}},E=(e)=>`THROW ${e&&e.name}${e&&e.code?` ${e.code}`:''}: ${String(e&&e.message).split('\n')[0]}`,show=(k,f)=>{let s;try{s=D(f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)},showA=async(k,f)=>{let s;try{s=D(await f())}catch(e){s=E(e)}process.stdout.write(`${k}: ${s}\n`)};
const os = require('os');
show('platform matches process', () => os.platform() === process.platform);
show('EOL', () => os.EOL);
show('tmpdir', () => typeof os.tmpdir());
show('homedir === HOME', () => os.homedir() === process.env.HOME);
show('hostname', () => typeof os.hostname());
show('cpus', () => Array.isArray(os.cpus()) && os.cpus().length > 0);
show('type', () => typeof os.type());
show('userInfo', () => typeof os.userInfo().username);
show('arch', () => typeof os.arch());
show('totalmem', () => typeof os.totalmem());
show('networkInterfaces', () => typeof os.networkInterfaces());
show('constants.signals.SIGINT', () => os.constants && os.constants.signals && os.constants.signals.SIGINT);
show('availableParallelism', () => typeof os.availableParallelism);
