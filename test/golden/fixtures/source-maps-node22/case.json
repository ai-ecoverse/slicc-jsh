{
  "description": "source maps: --enable-source-maps stacks and uncaught reports (inline map with sourcesContent, a .map file read from disk, an ES module), process.setSourceMapsEnabled, module.findSourceMap / SourceMap / getSourceMapsSupport",
  "argv": [
    "script.js"
  ],
  "shim": true,
  "files": [
    {
      "path": "/os/dist/esm.mjs",
      "from": "dist/esm.mjs"
    },
    {
      "path": "/os/dist/esm.mjs.map",
      "from": "dist/esm.mjs.map"
    },
    {
      "path": "/os/dist/file.js",
      "from": "dist/file.js"
    },
    {
      "path": "/os/dist/file.js.map",
      "from": "dist/file.js.map"
    },
    {
      "path": "/os/dist/inline.js",
      "from": "dist/inline.js"
    },
    {
      "path": "/os/dist/nosrc.js",
      "from": "dist/nosrc.js"
    },
    {
      "path": "/os/dist/nosrc.js.map",
      "from": "dist/nosrc.js.map"
    },
    {
      "path": "/os/package.json",
      "from": "package.json"
    },
    {
      "path": "/os/script.js",
      "from": "script.js"
    },
    {
      "path": "/os/src/main.ts",
      "from": "src/main.ts"
    },
    {
      "path": "/os/src/orig.ts",
      "from": "src/orig.ts"
    }
  ]
}
