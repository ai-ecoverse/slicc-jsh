http.get: response early chunked
http.get: data "first;" early
http.get: data "last" late
fetch: headers 200
fetch: body "first;last"
sse: headers 200 text/event-stream
sse: events ["id: 1 | data: event 1","id: 2 | data: event 2","id: 3 | data: event 3"]
sse: read after abort AbortError
server: the SSE client went away
post: headers 200 application/x-ndjson
post: line {"i":0,"got":"hello"}
post: line {"i":1,"got":"hello"}
post: line {"i":2,"got":"hello"}
server: setHeader ERR_HTTP_HEADERS_SENT Cannot set headers after they are sent to the client
server: removeHeader ERR_HTTP_HEADERS_SENT Cannot remove headers after they are sent to the client
server: writeHead ERR_HTTP_HEADERS_SENT Cannot write headers after they are sent to the client
server: flushHeaders undefined
cut: fetch body TypeError terminated UND_ERR_SOCKET
cut: http.get aborted
cut: http.get error ECONNRESET aborted
