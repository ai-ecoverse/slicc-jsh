advanced values: message {"map":[["k",{"v":1}]],"set":[1,"a"],"date":"1970-01-02T00:00:00.000Z","big":"bigint","buf":"Buffer 6869","u16":[1,65535],"err":["RangeError","bad","why"],"circular":true,"holes":"3 false undefined","undef":true} | message {} | disconnect | exit 0 null | close 0 null
