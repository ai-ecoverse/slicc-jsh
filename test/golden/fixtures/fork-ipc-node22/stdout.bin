--- echo advanced
top-level bigint TypeError ERR_INVALID_ARG_TYPE The "message" argument must be one of type string, object, number, or boolean. Received type bigint (10n)
echo advanced: message {"got":{},"kind":"[object Map]"} | message {"got":"1970-01-01T00:00:00.000Z","kind":"[object Date]"} | message {"got":{"0":1,"1":2},"kind":"[object Uint8Array]"} | message {"got":{"big":"10n"},"kind":"[object Object]"} | message "bye too" | disconnect | exit 0 null | close 0 null
--- child info
child info: message {"send":"function","connected":true,"channel":"object","fd":3,"execArgv":["--no-warnings"],"argv":["info","x","y"]} | disconnect | exit 0 null | close 0 null
child info advanced: message {"send":"function","connected":true,"channel":"object","fd":3,"execArgv":[],"argv":["info"]} | disconnect | exit 0 null | close 0 null
