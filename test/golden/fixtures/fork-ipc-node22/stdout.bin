spawn ipc 4: message {"send":"function","connected":true,"channel":"object","fd":4,"execArgv":[],"argv":["info"]} | disconnect | exit 0 null | close 0 null
fork stdio pipe: message {"send":"function","connected":true,"channel":"object","fd":3,"execArgv":[],"argv":["info"]} | disconnect | exit 0 null | close 0 null
